# user_behavior.csv, graph_triples.csv, seed_data_books.sql, user_id_map.json)
# are intentionally NOT excluded — they must be baked into the image.
data/raw/
data/_*.pkl

__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
